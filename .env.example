# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. Everything below has a safe
# development fallback baked into docker-compose.yml EXCEPT the external
# provider credentials (Razorpay, Firebase, Resend, S3/R2), which must be
# supplied for those integrations to actually function.
# ---------------------------------------------------------------------------

# --- Database ---
DATABASE_URL=postgresql://lostfound:lostfound_dev_password@localhost:5432/lostfound

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
FIELD_ENCRYPTION_KEY=change-me-32-chars-minimum-secret

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@campuslostfound.app

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Object storage (S3 or Cloudflare R2 - both S3-compatible) ---
STORAGE_BUCKET=lostfound-dev
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
STORAGE_ENDPOINT=

# --- Firebase Cloud Messaging (mobile push) ---
# Base64-encode the full service account JSON before pasting here.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Web Push (VAPID) ---
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com

# --- ML service ---
ML_SERVICE_URL=http://localhost:8000
VISION_MODEL_NAME=openai/clip-vit-base-patch32
TEXT_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
OCR_ENGINE=tesseract
DETECTION_MODEL_NAME=yolov8n
ENABLE_SEGMENTATION=false
ML_DEVICE=cpu

# --- Monitoring / analytics (optional) ---
SENTRY_DSN=
POSTHOG_API_KEY=

# --- Web app ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

PORT=4000
